FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY backend/requirements.txt .

# Install Python dependencies with production optimizations
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install gunicorn

# Copy shared services/utilities
COPY backend/services services/

# Copy payment models
COPY backend/models/__init__.py models/
COPY backend/models/payment models/payment

# Copy db utilities
COPY backend/db db/

# Setup Python path
ENV PYTHONPATH=/app:$PYTHONPATH

# Expose port
EXPOSE 8007

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8007/health || exit 1

# Run the payment service
CMD ["gunicorn", "-w", "4", "-k", "uvicorn.workers.UvicornWorker", \
     "-b", "0.0.0.0:8007", "services.payment.main:app"]